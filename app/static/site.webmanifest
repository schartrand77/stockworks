{
  "id": "/",
  "name": "StockWorks Inventory",
  "short_name": "StockWorks",
  "description": "Inventory, hardware, quoting, and stock tracking for modern maker studios.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait-primary",
  "background_color": "#1f2026",
  "theme_color": "#1f2026",
  "categories": ["productivity", "business", "utilities"],
  "prefer_related_applications": false,
  "shortcuts": [
    {
      "name": "Materials",
      "short_name": "Materials",
      "description": "Jump to the filament material manager.",
      "url": "/?tab=materials"
    },
    {
      "name": "Inventory",
      "short_name": "Inventory",
      "description": "Open the spool/inventory tracking screen.",
      "url": "/?tab=inventory"
    },
    {
      "name": "Models",
      "short_name": "Models",
      "description": "View 3D print models and sales.",
      "url": "/?tab=models"
    },
    {
      "name": "Hardware",
      "short_name": "Hardware",
      "description": "View non-filament hardware bins.",
      "url": "/?tab=hardware"
    },
    {
      "name": "Stock movements",
      "short_name": "Movements",
      "description": "Log and review movement history.",
      "url": "/?tab=movements"
    }
  ],
  "icons": [
    {
      "src": "/public/favicon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
