# Container user/group ownership
PUID=1000
PGID=1000
UMASK=002

# App runtime
TZ=UTC
APP_PORT=8000

# Storage configuration
STOCKWORKS_DATA_DIR=/data
STOCKWORKS_DB_FILENAME=app.db
STOCKWORKS_MAX_UPLOAD_BYTES=10485760

# Optional external database (leave blank for SQLite)
# If you reuse an OrderWorks DSN like `...?schema=orderworks`, StockWorks still keeps
# its own tables in `public` by default. Set STOCKWORKS_DB_SCHEMA only when you want
# StockWorks materials/inventory in a separate schema.
DATABASE_URL=
STOCKWORKS_DB_SCHEMA=

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=change-this-to-a-strong-password
SHOP_USERNAME=
SHOP_EMAIL=
SHOP_PASSWORD=

# Secret used for session signing (change in production)
SECRET_KEY=replace-with-a-random-32-plus-character-secret
SESSION_HTTPS_ONLY=1
SESSION_SAME_SITE=strict
SESSION_MAX_AGE_SECONDS=28800
CORS_ALLOW_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Login brute-force protection
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# Low-stock digest email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=1
LOW_STOCK_DIGEST_FROM=
LOW_STOCK_DIGEST_RECIPIENTS=

# Label printing
STOCKWORKS_MAX_BATCH_LABELS=250

# OrderWorks integration (optional HTTP fallback)
# Leave these blank if StockWorks already connects directly to the MakerWorks Postgres database.
# Fill them in only when StockWorks must call the OrderWorks API over HTTP.
ORDERWORKS_BASE_URL=
ORDERWORKS_ADMIN_USERNAME=
ORDERWORKS_ADMIN_PASSWORD=

# PrintLab integration (optional)
# Used to read loaded filament trays from /api/printers or /api/fleet.
# Default below works when StockWorks runs in Docker and PrintLab runs on the host at port 8080.
# Leave PRINTLAB_API_KEY and PRINTLAB_BEARER_TOKEN blank unless your PrintLab instance requires auth.
PRINTLAB_BASE_URL=http://host.docker.internal:8080
PRINTLAB_API_KEY=
PRINTLAB_BEARER_TOKEN=
PRINTLAB_API_AUTH_HEADER=X-API-Key
PRINTLAB_TRACE=0
