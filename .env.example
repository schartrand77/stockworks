# Container user/group ownership
PUID=1000
PGID=1000
UMASK=002

# App runtime
TZ=UTC
APP_PORT=8000

# Storage configuration
STOCKWORKS_DATA_DIR=/data
STOCKWORKS_DB_FILENAME=app.db

# Optional external database (leave blank for SQLite)
# If you reuse an OrderWorks DSN like `...?schema=orderworks`, StockWorks still keeps
# its own tables in `public` by default. Set STOCKWORKS_DB_SCHEMA only when you want
# StockWorks materials/inventory in a separate schema.
DATABASE_URL=
STOCKWORKS_DB_SCHEMA=

# Admin authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# Secret used for session signing (change in production)
SECRET_KEY=replace-with-a-random-32-plus-character-secret
SESSION_HTTPS_ONLY=1
SESSION_SAME_SITE=strict
SESSION_MAX_AGE_SECONDS=28800
CORS_ALLOW_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Login brute-force protection
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_BLOCK_SECONDS=900

# OrderWorks integration (optional HTTP fallback)
# Leave these blank if StockWorks already connects directly to the MakerWorks Postgres database.
# Fill them in only when StockWorks must call the OrderWorks API over HTTP.
ORDERWORKS_BASE_URL=
ORDERWORKS_ADMIN_USERNAME=
ORDERWORKS_ADMIN_PASSWORD=

# PrintLab / legacy Bambu View integration (optional)
# Used to read loaded filament trays from /api/printers or legacy /api/fleet.
BAMBU_VIEW_BASE_URL=
BAMBU_VIEW_API_KEY=
BAMBU_VIEW_API_AUTH_HEADER=X-API-Key
BAMBU_VIEW_ADMIN_USERNAME=
BAMBU_VIEW_ADMIN_PASSWORD=
BAMBU_VIEW_TRACE=0
